# Database Configuration (Neon / Supabase PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET="your-nextauth-secret-here-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Configuration (Server-side only)
# Used for classification, theme clustering, Ask LOOP grounded Q&A, and VoC report generation
# Keep secure and never expose to client components
GEMINI_API_KEY="AIzaSy..."
